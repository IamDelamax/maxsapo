---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
---
<BaseLayout title="Contact — Max Sapo">
  <PageHeader
    eyebrow="Contact"
    title="Useful conversations welcome."
    lede="Especially around AI infrastructure, human AI interfaces, product strategy, speaking, and thoughtful collaborations."
  />
  <section class="container grid two">
    <div class="card">
      <div class="card-meta">Email</div>
      <h3><a href={`mailto:${site.email}`}>{site.email}</a></h3>
      <p>If the custom email is not active yet, use LinkedIn or GitHub for now.</p>
    </div>
    <div class="card">
      <div class="card-meta">Social</div>
      <h3>Elsewhere</h3>
      <p><a href={site.social.linkedin}>LinkedIn</a> · <a href={site.social.github}>GitHub</a></p>
    </div>
  </section>
</BaseLayout>
