---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('writing')).filter((post) => !post.data.draft);
  return posts.map((post) => ({ params: { slug: post.id.replace(/\.(md|mdx)$/, '') }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={`${post.data.title} — Max Sapo`} description={post.data.description}>
  <article class="container prose">
    <p class="eyebrow">{post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
    <h1>{post.data.title}</h1>
    <p class="lede">{post.data.description}</p>
    <Content />
  </article>
</BaseLayout>
