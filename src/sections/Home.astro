---
import BaseLayout from '../layouts/BaseLayout.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import PillarIcon from '../components/PillarIcon.astro';
import BalanceWheel from '../components/BalanceWheel.astro';
import { getContent, type Lang } from '../i18n';
import { site } from '../data/site';
import { videos } from '../data/videos';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getContent(lang);
const heroVideo = videos.find((v) => v.id === 'agi-summit')!;
const rapVideo = videos.find((v) => v.id === 'hbs-essay')!;
const homeVideos = ['bay-signal', 'digital-human', 'chakroff', 'happyverse-rap']
  .map((id) => videos.find((v) => v.id === id)!)
  .filter(Boolean);
---
<BaseLayout lang={lang}>
  <section class="container hero">
    <div class="hero-copy">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1>
        {t.hero.title}
        <span class="accent">{t.hero.titleAccent}</span>
      </h1>
      <p class="lede">{t.hero.lede}</p>
      <div class="actions">
        {t.hero.ctas.map((cta) => (
          <a class={cta.primary ? 'button primary' : 'button'} href={cta.href}>{cta.label}</a>
        ))}
      </div>
    </div>
    <figure class="hero-portrait">
      <img src="/img/hero-coast.jpg" alt={t.hero.portraitAlt} width="1400" height="1050" loading="eager" />
      <figcaption>{t.hero.portraitCaption} · <a href={site.social.instagram} target="_blank" rel="noopener noreferrer">@delamax</a></figcaption>
    </figure>
  </section>

  <section class="container stats-band" aria-label="Numbers">
    {t.stats.map((s) =>
      'href' in s && s.href ? (
        <a class="stat stat-link" href={s.href} target="_blank" rel="noopener noreferrer">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </a>
      ) : (
        <div class="stat">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ),
    )}
  </section>


  <section class="container section" id="life">
    <div class="section-header">
      <div>
        <p class="eyebrow">{t.pillars.eyebrow}</p>
        <h2>{t.pillars.title}</h2>
      </div>
      <p>{t.pillars.lede}</p>
    </div>
    <div class="pillar-grid">
      {t.pillars.items.map((p, i) => (
        <a class={`pillar pillar-${p.key}`} id={p.key} href={p.href}>
          <div class="pillar-head">
            <span class="pillar-glyph"><PillarIcon name={p.key} /></span>
            <span class="pillar-num">0{i + 1}</span>
            <span class="pillar-label">{p.label}</span>
          </div>
          <h3>{p.title}</h3>
          <p>{p.tagline}</p>
          <span class="pillar-link">{t.pillars.enter} →</span>
        </a>
      ))}
    </div>
  </section>

  <BalanceWheel lang={lang} />

  <section class="container section" id="coaching">
    <div class="coaching-band">
      <div class="coaching-copy">
        <p class="eyebrow">{t.coaching.eyebrow}</p>
        <h2>{t.coaching.title}</h2>
        <p class="coaching-lede">{t.coaching.lede}</p>
        <ul class="coaching-points">
          {t.coaching.points.map((point) => <li>{point}</li>)}
        </ul>
        <div class="actions">
          <a class="button coaching-cta" href={t.coaching.cta.href}>{t.coaching.cta.label}</a>
        </div>
        <p class="coaching-note">
          {t.coaching.note}
          <a href={t.coaching.noteLink.href} target="_blank" rel="noopener noreferrer">{t.coaching.noteLink.label}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="container section california-band" aria-label={t.california.title}>
    <div class="section-header">
      <div>
        <p class="eyebrow">{t.california.eyebrow}</p>
        <h2>{t.california.title}</h2>
      </div>
    </div>
    <div class="photo-strip">
      {t.california.photos.map((p) => (
        <figure class="photo-card">
          <img src={p.src} alt={p.alt} loading="lazy" />
        </figure>
      ))}
    </div>
  </section>

  <section class="container section delamax-band" id="delamax">
    <div class="delamax-inner">
      <div class="delamax-copy">
        <p class="eyebrow">{t.delamax.eyebrow}</p>
        <h2 class="delamax-title">{t.delamax.title}</h2>
        <p>{t.delamax.lede}</p>
        <div class="delamax-facts">
          {t.delamax.facts.map((f) => (
            <div class="stat">
              <span class="stat-value">{f.value}</span>
              <span class="stat-label">{f.label}</span>
            </div>
          ))}
        </div>
        <div class="actions">
          <a class="button" href={t.delamax.cta.href}>{t.delamax.cta.label}</a>
          <a class="button" href={t.delamax.cta2.href} target="_blank" rel="noopener noreferrer">{t.delamax.cta2.label}</a>
        </div>
      </div>
      <div class="delamax-video">
        <YouTubeEmbed youtubeId={rapVideo.youtubeId} title={rapVideo.title} />
      </div>
    </div>
  </section>

  <section class="container section" id="watch">
    <div class="section-header">
      <div>
        <p class="eyebrow">{t.watch.eyebrow}</p>
        <h2>{t.watch.sections.talks.title}</h2>
      </div>
      <a class="button" href={lang === 'ru' ? '/ru/watch' : '/watch'}>{t.watch.seeAll}</a>
    </div>
    <div class="video-feature">
      <YouTubeEmbed youtubeId={heroVideo.youtubeId} title={heroVideo.title} />
      <div class="video-feature-copy">
        <h3>{heroVideo.title}</h3>
        <p>{t.watch.notes[heroVideo.id]}</p>
      </div>
    </div>
    <div class="video-grid home-video-grid">
      {homeVideos.map((v) => (
        <article class="video-card">
          <YouTubeEmbed youtubeId={v.youtubeId} title={v.title} />
          <h3>{v.title}</h3>
          {t.watch.notes[v.id] && <p>{t.watch.notes[v.id]}</p>}
        </article>
      ))}
    </div>
  </section>

  <section class="container section" id="writing">
    <div class="section-header">
      <div>
        <p class="eyebrow">{t.writing.eyebrow}</p>
        <h2>{t.writing.title}</h2>
      </div>
      <p>{t.writing.lede}</p>
    </div>
    <div class="grid two">
      {t.writing.items.map((item) => (
        <a class="card writing-item" href={item.href} target="_blank" rel="noopener noreferrer">
          <div class="card-meta">{item.source}</div>
          <h3>{item.title}</h3>
          <p>{item.note}</p>
        </a>
      ))}
      <a class="card writing-item substack-card" href={t.writing.substack.href} target="_blank" rel="noopener noreferrer">
        <div class="card-meta">Substack</div>
        <h3>{t.writing.substack.title}</h3>
        <p>{t.writing.substack.body}</p>
        <span class="pillar-link">{t.writing.substack.cta} →</span>
      </a>
    </div>
  </section>

  <section class="container section" id="follow">
    <div class="section-header">
      <div>
        <p class="eyebrow">{t.follow.eyebrow}</p>
        <h2>{t.follow.title}</h2>
      </div>
      <p>{t.follow.lede}</p>
    </div>
    <div class="follow-grid">
      {t.follow.tiles.map((tile) => (
        <a
          class={`social-tile ${tile.img ? '' : 'social-tile-x'}`}
          href={tile.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          {tile.img && <img src={tile.img} alt={tile.alt} loading="lazy" />}
          <span class="social-badge">{tile.platform}</span>
          <span class="social-caption">
            <span class="social-text">{tile.caption}</span>
            <span class="social-cta">{tile.cta} →</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="container section" id="now">
    <div class="section-header">
      <div>
        <p class="eyebrow">{t.now.eyebrow}</p>
        <h2>{t.now.title}</h2>
      </div>
      <p>{t.now.lede}</p>
    </div>
    <div class="now-list">
      {t.now.items.map((item) => (
        <article class="now-item">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container section contact-band" id="contact">
    <p class="eyebrow">{t.contact.eyebrow}</p>
    <h2>{t.contact.title}</h2>
    <p class="lede">{t.contact.lede}</p>
    <div class="actions">
      <a class="button primary" href={`mailto:${site.email}`}>{t.contact.emailLabel} — {site.email}</a>
    </div>
    <div class="contact-cols">
      <div>
        <ul class="contact-list">
          {t.contact.links.map((l) => (
            <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="block-title">{t.contact.venturesTitle}</p>
        <ul class="contact-list">
          {t.contact.ventures.map((l) => (
            <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
