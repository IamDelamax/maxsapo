---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import { getContent, type Lang } from '../i18n';
import { videosByCategory, type VideoCategory } from '../data/videos';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getContent(lang);
const categories: VideoCategory[] = ['talks', 'product', 'music'];
---
<BaseLayout lang={lang} title={`${t.watch.title} — Max Sapo`} description={t.watch.lede}>
  <PageHeader eyebrow={t.watch.eyebrow} title={t.watch.title} lede={t.watch.lede} />
  {categories.map((cat) => (
    <section class="container section" id={cat}>
      <div class="section-header">
        <div>
          <h2>{t.watch.sections[cat].title}</h2>
        </div>
        <p>{t.watch.sections[cat].lede}</p>
      </div>
      <div class="video-grid">
        {videosByCategory(cat).map((v) => (
          <article class="video-card">
            <YouTubeEmbed youtubeId={v.youtubeId} title={v.title} />
            <h3>{v.title}</h3>
            {t.watch.notes[v.id] && <p>{t.watch.notes[v.id]}</p>}
            <a class="video-ext" href={`https://www.youtube.com/watch?v=${v.youtubeId}`} target="_blank" rel="noopener noreferrer">{t.watch.watchOn} →</a>
          </article>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
