---
import '../styles/global.css';
import { site } from '../data/site';
import { getContent, altHref, type Lang } from '../i18n';
import MobileNav from '../components/MobileNav.astro';
import PillarIcon from '../components/PillarIcon.astro';
import LogoMark from '../components/LogoMark.astro';
import SocialIcons from '../components/SocialIcons.astro';
import MobileMenu from '../components/MobileMenu.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  lang = 'en',
  title: titleProp,
  description: descriptionProp,
  image = '/og-image.jpg',
  type = 'website',
  noindex = false,
} = Astro.props;

const t = getContent(lang);
const title = titleProp ?? t.meta.title;
const description = descriptionProp ?? t.meta.description;

const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImageUrl = new URL(image, site.url).toString();
const currentPath = Astro.url.pathname;
const switchHref = altHref(lang, currentPath);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: 'Delamax',
  url: site.url,
  jobTitle: 'Senior Product Manager, Google Cloud TPU · Founder, Happyverse.AI',
  description: t.meta.description,
  sameAs: [
    site.social.linkedin,
    site.social.instagram,
    site.social.youtube,
    site.social.x,
    site.social.github,
  ].filter(Boolean),
};
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdf8f1" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="alternate" hreflang={lang === 'en' ? 'ru' : 'en'} href={new URL(switchHref, site.url).toString()} />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <ClientRouter />

    <script is:inline>
      // GH Pages 301s bare paths to trailing-slash, but ClientRouter
      // navigations keep the bare href — normalize so each page is one row
      // in GoatCounter. The stats page itself is not counted.
      window.goatcounter = {
        path: function (p) {
          if (p.indexOf('/stats') === 0) return null;
          return p.slice(-1) === '/' ? p : p + '/';
        },
      };
    </script>
    <script is:inline data-goatcounter={`${site.goatcounter}/count`} async src="https://gc.zgo.at/count.js"></script>
    <script>
      // count.js only counts the initial load; view-transition navigations
      // need an explicit count.
      document.addEventListener('astro:after-swap', () => {
        (window as any).goatcounter?.count?.();
      });
    </script>

    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href={lang === 'ru' ? '/ru/' : '/'} aria-label="Max Sapo home">
          <LogoMark />
          <span class="logo-name">Max Sapo</span>
        </a>
        <nav class="nav" aria-label="Main navigation">
          <div class="nav-drop">
            <button class="nav-link nav-drop-trigger" type="button" aria-haspopup="true">
              {t.navHappiness.label}
              <svg class="caret" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" /></svg>
            </button>
            <div class="nav-drop-menu">
              {t.navHappiness.items.map((item) => (
                <a
                  href={item.href}
                  class={`nav-drop-item ${['love', 'health', 'work', 'wealth'].includes(item.key) ? `pillar-${item.key}` : 'nav-drop-plain'}`}
                  data-key={item.key}
                >
                  {['love', 'health', 'work', 'wealth'].includes(item.key) && (
                    <span class="nav-drop-icon"><PillarIcon name={item.key as any} size={16} /></span>
                  )}
                  <span>{item.label}</span>
                </a>
              ))}
            </div>
          </div>
          {t.nav.map((item) => {
            const base = item.href.split('#')[0];
            const isActive = base !== '/' && base !== '/ru/' && currentPath.startsWith(base);
            return (
              <a
                href={item.href}
                class={isActive ? 'nav-link active' : 'nav-link'}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          })}
          <a href={switchHref} class="nav-link lang-switch" title={t.alt.title}>{t.alt.label}</a>
        </nav>
        <MobileNav />
      </div>
    </header>
    <MobileMenu currentPath={currentPath} lang={lang} />
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-id">
          <span class="footer-name">Max Sapo</span>
          <span class="footer-rights">© {new Date().getFullYear()} Max Sapo. {t.footer.rights}</span>
        </div>
        <SocialIcons size={20} />
      </div>
    </footer>
  </body>
</html>
