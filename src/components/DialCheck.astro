---
import { getContent, type Lang } from '../i18n';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  quadrant: 'love' | 'health' | 'wealth';
}
const { lang, quadrant } = Astro.props;
const t = getContent(lang);
const q = t.quadrants[quadrant];
const d = t.dialCheck;

const config = {
  email: site.email,
  mailPrefix: d.mailPrefix,
  label: q.label,
  verdicts: d.verdicts,
  dials: q.dials.map((dial) => dial.name),
  storage: `hiperflow.${quadrant}`,
};
---
<section class={`container section q-${quadrant}`}>
  <div class="dial-check card" data-dialcheck data-config={JSON.stringify(config)}>
    <div class="dial-check-copy">
      <p class="eyebrow">{d.eyebrow}</p>
      <h3>{d.title}</h3>
      <p class="dial-check-intro">{d.intro}</p>
      <div class="dial-check-rows">
        {q.dials.map((dial, i) => (
          <div class="dial-check-row" data-dial={i}>
            <div class="dial-check-row-head">
              <span class="dial-check-name">{dial.name}</span>
              <span class="dial-check-verdict" data-verdict></span>
            </div>
            <div class="dial-dots" role="radiogroup" aria-label={dial.name}>
              {[1, 2, 3, 4, 5].map((v) => (
                <button type="button" class="dial-dot" data-val={v} aria-label={`${dial.name}: ${v}/5`}>{v}</button>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="dial-check-result">
      <div class="dial-ring" aria-hidden="true">
        <svg viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="40" class="ring-track" />
          <circle cx="50" cy="50" r="40" class="ring-fill" data-ring transform="rotate(-90 50 50)" />
        </svg>
        <div class="dial-ring-value"><span data-avg>–</span><small>/5</small></div>
      </div>
      <p class="dial-check-score-label">{d.scoreLabel}</p>
      <p class="dial-check-overall" data-overall></p>
      <a class="button primary" data-cta href={`mailto:${site.email}`}>{d.cta}</a>
      <p class="dial-check-note">{d.note}</p>
    </div>
  </div>
</section>

<script>
  function setupDialCheck() {
    const root = document.querySelector('[data-dialcheck]') as HTMLElement | null;
    if (!root || root.dataset.ready === '1') return;
    root.dataset.ready = '1';
    const config = JSON.parse(root.dataset.config || '{}');
    const CIRC = 2 * Math.PI * 40;

    const rows = Array.from(root.querySelectorAll<HTMLElement>('.dial-check-row'));
    const avgEl = root.querySelector<HTMLElement>('[data-avg]')!;
    const ringEl = root.querySelector<SVGCircleElement>('[data-ring]')!;
    const overallEl = root.querySelector<HTMLElement>('[data-overall]')!;
    const ctaEl = root.querySelector<HTMLAnchorElement>('[data-cta]')!;

    let scores: Record<string, number> = {};
    try {
      scores = JSON.parse(localStorage.getItem(config.storage) || '{}');
    } catch {}

    const verdict = (v: number) =>
      v <= 2 ? config.verdicts.pain : v <= 4 ? config.verdicts.growth : config.verdicts.great;

    function render() {
      const values: number[] = [];
      rows.forEach((row, i) => {
        const v = scores[i];
        const dots = row.querySelectorAll<HTMLButtonElement>('.dial-dot');
        dots.forEach((dot) => {
          dot.classList.toggle('active', v != null && Number(dot.dataset.val) <= v);
        });
        const verdictEl = row.querySelector<HTMLElement>('[data-verdict]')!;
        verdictEl.textContent = v != null ? verdict(v) : '';
        verdictEl.dataset.tone = v == null ? '' : v <= 2 ? 'pain' : v <= 4 ? 'growth' : 'great';
        if (v != null) values.push(v);
      });

      if (values.length === rows.length) {
        const avg = values.reduce((a, b) => a + b, 0) / values.length;
        avgEl.textContent = (Math.round(avg * 10) / 10).toString();
        ringEl.style.strokeDasharray = `${(avg / 5) * CIRC} ${CIRC}`;
        overallEl.textContent = verdict(Math.round(avg));
        const summary = config.dials.map((name: string, i: number) => `${name} ${scores[i]}/5`).join(', ');
        ctaEl.href = `mailto:${config.email}?subject=${encodeURIComponent(
          `${config.mailPrefix} — ${config.label} ${(Math.round(avg * 10) / 10)}/5 (${summary})`,
        )}`;
      } else {
        avgEl.textContent = '–';
        ringEl.style.strokeDasharray = `0 ${CIRC}`;
        overallEl.textContent = '';
      }
    }

    rows.forEach((row, i) => {
      row.querySelectorAll<HTMLButtonElement>('.dial-dot').forEach((dot) => {
        dot.addEventListener('click', () => {
          scores[i] = Number(dot.dataset.val);
          try {
            localStorage.setItem(config.storage, JSON.stringify(scores));
          } catch {}
          render();
        });
      });
    });

    render();
  }

  setupDialCheck();
  document.addEventListener('astro:page-load', setupDialCheck);
</script>
