---
// Hamburger toggle only. The drawer itself is rendered by MobileMenu.astro
// outside the sticky header: the header's backdrop-filter makes it the
// containing block for fixed descendants (WebKit enforces this), which
// collapsed the fixed drawer to the header strip on iOS.
---

<div class="mobile-nav-wrapper">
  <button
    id="mobile-nav-toggle"
    class="mobile-nav-toggle"
    aria-label="Toggle navigation menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span class="hamburger-box">
      <span class="hamburger-inner"></span>
    </span>
  </button>
</div>
