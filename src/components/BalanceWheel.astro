---
import { getContent, type Lang } from '../i18n';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getContent(lang);
const c = t.check;

const COLORS: Record<string, { main: string; light: string }> = {
  love: { main: '#e8447c', light: '#f77aa5' },
  health: { main: '#16a34a', light: '#4ecb7d' },
  work: { main: '#f59e0b', light: '#fbc353' },
  wealth: { main: '#0284c7', light: '#41b0e8' },
};

const quadrants = t.pillars.items.map((p) => ({
  key: p.key,
  label: p.label,
  href: p.href,
  color: COLORS[p.key].main,
  light: COLORS[p.key].light,
}));

// score rings between hub (36) and rim (100)
const rings = [1, 2, 3, 4].map((i) => 36 + (i / 5) * 64);

const config = {
  email: site.email,
  mailPrefix: c.mailPrefix,
  verdicts: c.verdicts,
  loudestPrefix: c.loudestPrefix,
  balanced: c.balanced,
  openTemplate: c.openTemplate,
  quadrants: quadrants.map(({ key, label, href }) => ({ key, label, href })),
};
---
<section class="container section" id="check">
  <div class="section-header">
    <div>
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.title}</h2>
    </div>
    <p>{c.lede}</p>
  </div>

  <div class="check-card card" data-balance data-config={JSON.stringify(config)}>
    <div class="check-controls">
      {quadrants.map((q) => (
        <div class="check-row" data-qkey={q.key}>
          <div class="check-row-head">
            <span class="check-label" style={`color:${q.color}`}>{q.label}</span>
            <span class="check-verdict" data-verdict></span>
          </div>
          <input
            type="range"
            min="0"
            max="100"
            step="1"
            value="60"
            data-score
            style={`accent-color:${q.color}`}
            aria-label={q.label}
          />
        </div>
      ))}
      <p class="check-loudest" data-loudest></p>
      <div class="actions check-actions">
        <a class="button primary" data-cta href={`mailto:${site.email}`}>{c.cta}</a>
        <a class="button" data-open href="/#life"></a>
      </div>
    </div>

    <div class="check-wheel" aria-hidden="true">
      <div class="wheel-wrap">
        <svg viewBox="-118 -118 236 236" data-wheel>
          <defs>
            {quadrants.map((q) => (
              <radialGradient id={`wg-${q.key}`} cx="0" cy="0" r="100" gradientUnits="userSpaceOnUse">
                <stop offset="30%" stop-color={q.light} />
                <stop offset="100%" stop-color={q.color} />
              </radialGradient>
            ))}
            <filter id="wheel-shadow" x="-30%" y="-30%" width="160%" height="160%">
              <feDropShadow dx="0" dy="3" stdDeviation="6" flood-color="#785020" flood-opacity="0.22" />
            </filter>
          </defs>

          <g data-ghosts></g>

          <g class="wheel-rings">
            {rings.map((r) => <circle r={r} />)}
          </g>

          <g data-segs filter="url(#wheel-shadow)"></g>

          <circle class="wheel-hub" r="31" />
          <text class="wheel-avg" text-anchor="middle" y="6">
            <tspan data-avg font-size="16" font-weight="800">–</tspan>
            <tspan font-size="8.5" dx="1" class="wheel-avg-denom">%</tspan>
          </text>
        </svg>

        {quadrants.map((q, i) => (
          <span
            class={`wheel-chip wheel-chip-${['tr', 'br', 'bl', 'tl'][i]}`}
            style={`color:${q.color}`}
            data-chip={q.key}
          >{q.label}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function setupBalanceWheel() {
    const root = document.querySelector('[data-balance]') as HTMLElement | null;
    if (!root || root.dataset.ready === '1') return;
    root.dataset.ready = '1';
    const config = JSON.parse(root.dataset.config || '{}');
    const STORAGE = 'hiperflow.home';

    const HUB = 36;
    const RIM = 100;
    const PAD = (4.2 * Math.PI) / 180; // angular gap on each side of a quadrant
    const CORNER = 9; // outer corner radius

    const rows = Array.from(root.querySelectorAll<HTMLElement>('.check-row'));
    const loudestEl = root.querySelector<HTMLElement>('[data-loudest]')!;
    const ctaEl = root.querySelector<HTMLAnchorElement>('[data-cta]')!;
    const openEl = root.querySelector<HTMLAnchorElement>('[data-open]')!;
    const avgEl = root.querySelector<SVGTSpanElement>('[data-avg]')!;
    const ghostsG = root.querySelector<SVGGElement>('[data-ghosts]')!;
    const segsG = root.querySelector<SVGGElement>('[data-segs]')!;

    const polar = (r: number, a: number) => `${(r * Math.cos(a)).toFixed(2)} ${(r * Math.sin(a)).toFixed(2)}`;

    // Quarter sector with rounded outer corners; center is covered by the hub.
    function sectorPath(r: number, a0: number, a1: number, corner: number) {
      const c = Math.min(corner, ((a1 - a0) * r) / 2.4, r - HUB);
      const d = r - c;
      const phi = Math.asin(c / d);
      const edge = d * Math.cos(phi);
      return [
        'M 0 0',
        `L ${polar(edge, a0)}`,
        `A ${c} ${c} 0 0 1 ${polar(r, a0 + phi)}`,
        `A ${r} ${r} 0 0 1 ${polar(r, a1 - phi)}`,
        `A ${c} ${c} 0 0 1 ${polar(edge, a1)}`,
        'Z',
      ].join(' ');
    }

    const NS = 'http://www.w3.org/2000/svg';
    const angles = (i: number) => {
      const base = (-90 + i * 90) * (Math.PI / 180);
      return [base + PAD, base + Math.PI / 2 - PAD] as const;
    };

    const segEls: Record<string, SVGPathElement> = {};
    config.quadrants.forEach((q: any, i: number) => {
      const [a0, a1] = angles(i);
      const ghost = document.createElementNS(NS, 'path');
      ghost.setAttribute('d', sectorPath(RIM, a0, a1, CORNER));
      ghost.setAttribute('class', 'wheel-ghost');
      ghost.setAttribute('fill', `url(#wg-${q.key})`);
      ghostsG.appendChild(ghost);

      const seg = document.createElementNS(NS, 'path');
      seg.setAttribute('fill', `url(#wg-${q.key})`);
      segsG.appendChild(seg);
      segEls[q.key] = seg;
    });

    let scores: Record<string, number> = {};
    try {
      scores = JSON.parse(localStorage.getItem(STORAGE) || '{}');
    } catch {}
    // migrate old 1–5 scores to percent
    for (const k of Object.keys(scores)) if (scores[k] <= 5) scores[k] = scores[k] * 20;

    const radius = (v: number) => HUB + (v / 100) * (RIM - HUB);
    const cur: Record<string, number> = {};
    config.quadrants.forEach((q: any) => (cur[q.key] = radius(scores[q.key] ?? 60)));

    let raf = 0;
    function animate() {
      cancelAnimationFrame(raf);
      const start = performance.now();
      const from = { ...cur };
      const to: Record<string, number> = {};
      config.quadrants.forEach((q: any) => (to[q.key] = radius(scores[q.key] ?? 60)));
      const DUR = 320;
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / DUR);
        const e = 1 - Math.pow(1 - p, 3);
        config.quadrants.forEach((q: any, i: number) => {
          cur[q.key] = from[q.key] + (to[q.key] - from[q.key]) * e;
          const [a0, a1] = angles(i);
          segEls[q.key].setAttribute('d', sectorPath(cur[q.key], a0, a1, CORNER));
        });
        if (p < 1) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    }

    const tone = (v: number) =>
      v < 20 ? 'emergency' : v < 40 ? 'pain' : v < 60 ? 'growth' : v < 80 ? 'ok' : 'excellent';
    const verdict = (v: number) => config.verdicts[tone(v)];

    function render() {
      let minKey = '';
      let minVal = 101;
      let sum = 0;
      for (const q of config.quadrants) {
        const v = scores[q.key] ?? 60;
        sum += v;
        const row = rows.find((r) => r.dataset.qkey === q.key);
        if (row) {
          const input = row.querySelector<HTMLInputElement>('[data-score]')!;
          if (Number(input.value) !== v) input.value = String(v);
          const verdictEl = row.querySelector<HTMLElement>('[data-verdict]')!;
          verdictEl.textContent = `${v}% · ${verdict(v)}`;
          verdictEl.dataset.tone = tone(v);
        }
        const chip = root.querySelector<HTMLElement>(`[data-chip="${q.key}"]`);
        if (chip) {
          chip.textContent = `${q.label} · ${v}%`;
          chip.classList.toggle('chip-sos', v < 20);
        }
        if (v < minVal) {
          minVal = v;
          minKey = q.key;
        }
      }
      avgEl.textContent = String(Math.round(sum / config.quadrants.length));
      animate();

      const minQ = config.quadrants.find((q: any) => q.key === minKey);
      if (minVal >= 95) {
        loudestEl.textContent = config.balanced;
        openEl.style.display = 'none';
      } else {
        loudestEl.textContent = `${config.loudestPrefix} ${minQ.label} — ${verdict(minVal)}.`;
        openEl.style.display = '';
        openEl.textContent = config.openTemplate.replace('{label}', minQ.label);
        openEl.href = minQ.href;
      }
      const summary = config.quadrants
        .map((q: any) => `${q.label} ${scores[q.key] ?? 60}%`)
        .join(', ');
      ctaEl.href = `mailto:${config.email}?subject=${encodeURIComponent(`${config.mailPrefix}: ${summary}`)}`;
    }

    rows.forEach((row) => {
      const input = row.querySelector<HTMLInputElement>('[data-score]')!;
      input.addEventListener('input', () => {
        scores[row.dataset.qkey!] = Number(input.value);
        try {
          localStorage.setItem(STORAGE, JSON.stringify(scores));
        } catch {}
        render();
      });
    });

    render();
  }

  setupBalanceWheel();
  document.addEventListener('astro:page-load', setupBalanceWheel);
</script>
